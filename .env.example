# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/brainwave
# Or Atlas:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/brainwave?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=1h
PORT=5000

# Frontend origin for CORS (comma-separated). https://*.onrender.com is also allowed.
CORS_ORIGIN=http://localhost:5173,https://your-frontend.onrender.com

# Optional seed users
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_HR_USERNAME=hr
SEED_HR_PASSWORD=Hr@12345
SEED_SALES_USERNAME=sales
SEED_SALES_PASSWORD=Sales@12345
SEED_SUPPORT_USERNAME=support
SEED_SUPPORT_PASSWORD=Support@12345
SEED_FINANCE_USERNAME=finance
SEED_FINANCE_PASSWORD=Finance@12345

# Zoho One - India data center (single backend service account)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

ZOHO_OAUTH_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token

ZOHO_PEOPLE_PORTAL_URL=https://people.zoho.in/
ZOHO_CRM_PORTAL_URL=https://crm.zoho.in/
ZOHO_DESK_PORTAL_URL=https://desk.zoho.in/
ZOHO_BOOKS_PORTAL_URL=https://books.zoho.in/

ZOHO_PEOPLE_API_BASE_URL=https://people.zoho.in/people/api
ZOHO_CRM_API_BASE_URL=https://www.zohoapis.in/crm/v2
ZOHO_DESK_API_BASE_URL=https://desk.zoho.in/api/v1
ZOHO_BOOKS_API_BASE_URL=https://www.zohoapis.in/books/v3

# Desk is mock by default because a live Desk org may be unavailable.
ZOHO_DESK_MOCK_MODE=true
ZOHO_DESK_ORG_ID=

# Optional. If empty, the backend uses GET /organizations and requires exactly one org.
ZOHO_BOOKS_ORGANIZATION_ID=
